# Cell Segmentation Model Configuration
# Example configuration for YOLOv8s-seg training

# Model
model: yolov8s-seg.pt  # Base pretrained model

# Data
data:
  path: ./data  # Dataset root
  train: train  # Training images relative to path
  val: val      # Validation images relative to path
  nc: 3         # Number of classes
  names:
    0: osteoblast
    1: epithelial
    2: calcium

# Training parameters
epochs: 100
patience: 20       # Early stopping patience
batch: 16
imgsz: 640         # Input image size
device: 0          # GPU device (0 = first GPU)

# Optimizer
optimizer: SGD
lr0: 0.001         # Initial learning rate
lrf: 0.01          # Final learning rate factor
momentum: 0.937
weight_decay: 0.0005

# Augmentation
augmentation:
  hsv_h: 0.015    # Image HSV-H augmentation
  hsv_s: 0.7      # Image HSV-S augmentation
  hsv_v: 0.4      # Image HSV-V augmentation
  degrees: 180.0   # Rotation (+/- deg)
  translate: 0.1   # Translation (+/- fraction)
  scale: 0.5       # Scale (+/- gain)
  shear: 0.0       # Shear (+/- deg)
  perspective: 0.0 # Perspective (+/- fraction)
  flipud: 0.5      # Flip up-down probability
  fliplr: 0.5      # Flip left-right probability
  mosaic: 1.0      # Mosaic augmentation
  mixup: 0.1       # MixUp augmentation

# Loss weights
loss:
  box: 7.5         # Box loss gain
  seg: 1.0         # Segmentation loss gain
  cls: 1.0         # Classification loss gain

# Output
project: ./models/trained
name: cellseg_yolov8s
exist_ok: true
save: true
save_period: -1    # Save checkpoint every N epochs (-1 = last only)

# Validation
val: true
plots: true
save_json: false

# Export settings (for ONNX conversion)
export:
  format: onnx
  opset: 11
  simplify: true
