# Docker Compose override for production deployment
# Generated by Ansible

services:
  cvat:
    environment:
      - CVAT_HOST={{ cvat_host | default('localhost') }}
    ports:
      - "{{ cvat_port | default('8080') }}:8080"
    volumes:
      - cvat_data:/home/django/data
      - cvat_logs:/var/log/cvat
    restart: unless-stopped
    deploy:
      resources:
        limits:
          memory: 4G
        reservations:
          memory: 2G

  cvat_db:
    environment:
      - POSTGRES_DB={{ cvat_db_name | default('cvat') }}
      - POSTGRES_USER={{ cvat_db_user | default('root') }}
      - POSTGRES_PASSWORD={{ cvat_db_password }}
    volumes:
      - cvat_db_data:/var/lib/postgresql/data
    restart: unless-stopped
    deploy:
      resources:
        limits:
          memory: 2G

  cvat_redis:
    environment:
      - REDIS_PASSWORD={{ cvat_redis_password }}
    volumes:
      - cvat_redis_data:/data
    restart: unless-stopped
    command: redis-server --requirepass {{ cvat_redis_password }}

volumes:
  cvat_data:
  cvat_logs:
  cvat_db_data:
  cvat_redis_data:
