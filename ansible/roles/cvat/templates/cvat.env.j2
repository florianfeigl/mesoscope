# CVAT Environment Configuration
# Generated by Ansible - Do not edit manually

# Admin credentials
CVAT_ADMIN_NAME=admin
CVAT_ADMIN_PASSWORD={{ cvat_admin_password }}
CVAT_ADMIN_EMAIL={{ cvat_admin_email | default('admin@localhost') }}

# Database settings
POSTGRES_USER={{ cvat_db_user | default('root') }}
POSTGRES_DB={{ cvat_db_name | default('cvat') }}
POSTGRES_PASSWORD={{ cvat_db_password }}

# Redis settings
REDIS_PASSWORD={{ cvat_redis_password }}

# Server settings
CVAT_HOST={{ cvat_host | default('localhost') }}
CVAT_PORT=8080

# Production settings
DJANGO_MODWSGI_EXTRA_ARGS=
ALLOWED_HOSTS=*
ADAPTIVE_AUTO_TRIM=False

# Logging
LOG_LEVEL=INFO

# Telemetry (disable for privacy)
CVAT_TELEMETRY_ENABLED=False
