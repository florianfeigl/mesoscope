# Caddy configuration for CVAT
# Generated by Ansible - managed file

{{ cvat_host }} {
    reverse_proxy localhost:{{ cvat_port | default(8080) }}
    
    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000;"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"
    }
    
    # Logging
    log {
        output file /var/log/caddy/cvat_access.log
        format json
    }
}
